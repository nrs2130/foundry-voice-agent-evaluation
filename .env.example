# Copy to .env and fill in. .env is git-ignored.

# Foundry project that hosts the voice agent and the evaluations.
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_TENANT_ID=<tenant-id>
AZURE_RESOURCE_GROUP=<resource-group>

# cli = Azure CLI token scoped to AZURE_SUBSCRIPTION_ID (recommended locally / in CI after azure/login)
# default = DefaultAzureCredential (managed identity, workload identity, ...)
AZURE_CREDENTIAL=cli

# Voice agent under test (created by `azd deploy`, see azure.yaml).
SIRE_AGENT_NAME=sire-voice-agent

# Chat model deployment used by the LLM-judge evaluators (tool_call_accuracy, intent_resolution).
# Judge runs are bound by its tokens per minute (~1.1M tokens per 120-row end-to-end run); 500K TPM recommended.
FOUNDRY_JUDGE_DEPLOYMENT=gpt-5.4-mini

# Azure AI Search service holding the tenant directory (users + groups).
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_USER_INDEX=sire-gamma-users
AZURE_SEARCH_GROUP_INDEX=sire-gamma-groups
# Optional: leave empty to use Entra ID (Search Index Data Reader/Contributor roles).
AZURE_SEARCH_API_KEY=

# Optional overrides for where the extracted regression corpus lives.
# SIRE_CORPUS_ROOT=test_data/extracted/tenant-gamma-regression-2026-11-11
# SIRE_CAPTURES_ROOT=test_data/extracted/tenant-gamma-regression-2026-11-11-captures
